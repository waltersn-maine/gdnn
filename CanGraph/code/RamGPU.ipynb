    "import psutil\n",
    "vm = psutil.virtual_memory()\n",
    "print(f\"Total RAM: {vm.total / 1e9:.1f} GB\")\n",
    "print(f\"Available: {vm.available / 1e9:.1f} GB\")\n",
    "print(f\"Used: {vm.percent:.1f}%\")"
   ]
